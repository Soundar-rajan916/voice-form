# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./voiceform.db

# JWT Authentication Secrets
JWT_SECRET=supersecretkey_change_in_production_voiceform_123
JWT_EXPIRE_MINUTES=1440

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@voiceform.com
ADMIN_PASSWORD=Admin@12345

# Groq Cloud API Credentials (Whisper STT & Llama Extraction)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Browser VAD Silence Durations (in milliseconds)
SILENCE_STRING_MS=600
SILENCE_NUMBER_MS=600
SILENCE_BOOLEAN_MS=600
SILENCE_CHOICE_MS=600
SILENCE_EMAIL_MS=1200
SILENCE_PHONE_MS=1200
SILENCE_DATE_MS=1200
 
# Email & Gmail Delivery Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
# Use a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME="Citizen Service Centre"
ENABLE_EMAIL_NOTIFICATIONS=true
